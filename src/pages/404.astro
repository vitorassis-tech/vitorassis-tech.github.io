---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/formato';
---

<BaseLayout title="Página não encontrada" noindex>
  <section class="container erro">
    <p class="codigo" aria-hidden="true">404</p>
    <h1>Esta rota não tem entrega.</h1>
    <p class="lede">O endereço digitado não existe ou foi alterado. Confira o link ou siga por um destes caminhos.</p>
    <div class="cta">
      <a class="btn btn-primary" href={url('/')}>Ir para a página inicial</a>
      <a class="btn btn-ghost" href={url('/projetos/')}>Ver projetos</a>
    </div>
  </section>
</BaseLayout>

<style>
  .erro { padding-block: clamp(3rem, 10vw, 7rem); }
  .codigo {
    font-family: var(--font-display);
    font-size: clamp(5rem, 18vw, 11rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--accent);
    margin: 0 0 1rem;
  }
  h1 { font-size: var(--step-4); max-width: 20ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
