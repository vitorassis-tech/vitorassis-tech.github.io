---
import BaseLayout from '../layouts/BaseLayout.astro';
import RotaCarreira from '../components/RotaCarreira.astro';
import CartaoProjeto from '../components/CartaoProjeto.astro';
import VitrineDemos from '../components/VitrineDemos.astro';
import FaixaContato from '../components/FaixaContato.astro';
import Tecnologias from '../components/Tecnologias.astro';
import { site, inicio, CURRICULO, temCurriculo } from '../data/site';
import { projetos } from '../data/projetos';
import { experiencias, formacaoAcademica, cursos } from '../data/trajetoria';
import { mesAno, periodo, url } from '../lib/formato';

// Projetos em destaque: definidos no painel (Página inicial). Só os publicados aparecem.
const destaques = inicio.projetosDestaque.map((s) => projetos.find((p) => p.slug === s)).filter((p) => p !== undefined);
const curriculo = temCurriculo();

/* Frase principal: a última palavra (sem a pontuação) recebe o destaque laranja. */
const [, fraseInicio, fraseDestaque, frasePontuacao] = /^(.*?)(\S+?)([.!?…]*)$/.exec(inicio.titulo.trim()) ?? [];

/* ---------- Indicadores: todos calculados a partir do conteúdo, nada digitado à mão ---------- */
const empresaLogistica = experiencias[0];
const [anoIni, mesIni] = empresaLogistica.inicio.split('-').map(Number);
const fimLogistica = empresaLogistica.fim ? empresaLogistica.fim.split('-').map(Number) : [new Date().getFullYear(), new Date().getMonth() + 1];
const anosLogistica = Math.floor((fimLogistica[0] * 12 + fimLogistica[1] - (anoIni * 12 + mesIni)) / 12);
const projetosTrabalho = projetos.filter((p) => p.natureza === 'trabalho').length;
const cursosConcluidos = cursos.filter((c) => c.status === 'concluido').length;
const tecnicosConcluidos = formacaoAcademica.filter((f) => f.status === 'concluido' && /^Técnico/i.test(f.curso)).length;
const indicadores = [
  { icone: 'maleta', valor: `${anosLogistica}+`, rotulo: 'anos na logística', detalhe: `${empresaLogistica.nomeCurto}, desde ${mesAno(empresaLogistica.inicio)}` },
  { icone: 'grafico', valor: String(projetosTrabalho), rotulo: projetosTrabalho === 1 ? 'projeto profissional' : 'projetos profissionais', detalhe: 'dashboards em Power BI' },
  { icone: 'certificado', valor: String(cursosConcluidos), rotulo: 'cursos concluídos', detalhe: 'Python, SQL, BI e mais' },
  { icone: 'capelo', valor: String(tecnicosConcluidos), rotulo: tecnicosConcluidos === 1 ? 'curso técnico' : 'cursos técnicos', detalhe: 'Logística e Qualidade' },
];

const cargos = empresaLogistica.cargos;
const graduacao = formacaoAcademica.find((f) => f.status === 'andamento');
const formacaoConcluida = formacaoAcademica.filter((f) => f.status === 'concluido' && /^Técnico/i.test(f.curso));
const cursosAndamento = cursos.filter((c) => c.status === 'andamento');

/* Ícones de linha (24 × 24), usados nas áreas, indicadores e frentes */
const ICONES: Record<string, string> = {
  caminhao: 'M3 6h11v9H3zM14 9h4l3 3v3h-7M7 18.5a1.5 1.5 0 1 0 0-.01M17 18.5a1.5 1.5 0 1 0 0-.01',
  grafico: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  codigo: 'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16',
  banco: 'M4.5 5.5a7.5 2.8 0 1 0 15 0a7.5 2.8 0 1 0-15 0M4.5 5.5v13c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8v-13M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8',
  ia: 'M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3M6 6h12v12H6zM9.5 9.5h5v5h-5z',
  maleta: 'M3 8h18v12H3zM8 8V5h8v3M3 13h18',
  certificado: 'M5 3h14v12H5zM9 8h6M9 11h4M10 15l-1.5 6 3.5-2 3.5 2L14 15',
  capelo: 'M2 9l10-5 10 5-10 5zM6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5M22 9v6',
  operacao: 'M3 21V9l9-6 9 6v12M8 21v-6h8v6M8 12h8',
  dados: 'M3 3v18h18M7 15l4-4 3 3 6-7',
};
const iconeArea = (nome: string) => {
  const n = nome.toLowerCase();
  if (n.includes('logística') || n.includes('transport')) return 'caminhao';
  if (n.includes('dados e bi') || n.includes('análise')) return 'grafico';
  if (n.includes('python')) return 'codigo';
  if (n.includes('banco') || n.includes('sql')) return 'banco';
  if (n.includes('intelig')) return 'ia';
  return 'grafico';
};
const iconeFrente = ['operacao', 'dados', 'capelo'];
---

<BaseLayout title={site.nome}>
  <!-- ============ Abertura ============ -->
  <section class="hero" aria-labelledby="hero-titulo">
    <picture>
      <source media="(max-width: 759px)" srcset={url('/img/fundos/hero-globo-movel.webp')} width="1080" height="1500" />
      <img
        class="hero-fundo"
        src={url('/img/fundos/hero-globo-1600.webp')}
        srcset={`${url('/img/fundos/hero-globo-1600.webp')} 1600w, ${url('/img/fundos/hero-globo.webp')} 2560w`}
        sizes="100vw"
        alt=""
        width="2560"
        height="1440"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="container hero-grade">
      <div class="hero-texto">
        <p class="selo-topo"><i aria-hidden="true"></i>Logística · Dados · Tecnologia</p>
        <h1 id="hero-titulo" class="nome">
          <span class="nome-1">{site.nome.split(' ')[0]}</span>{' '}<span class="nome-2">{site.nome.split(' ').slice(1).join(' ')}</span>
          <span class="visually-hidden">: {inicio.posicionamento}</span>
        </h1>
        <p class="posicionamento" aria-hidden="true">{inicio.posicionamento}</p>
        <p class="frase">{fraseInicio}<em>{fraseDestaque}</em>{frasePontuacao}</p>
        <p class="subtitulo">{inicio.subtitulo}</p>
        <div class="cta">
          <a class="btn btn-primary" href={url('/sobre/')}>
            Conheça minha trajetória
            <svg data-seta viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
          <a class="btn btn-linha" href={url('/projetos/')}>Explore meus projetos</a>
          {
            curriculo && (
              <a class="btn btn-linha" href={url(CURRICULO)} download>
                Baixar currículo
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 2v8m0 0 3.5-3.5M8 10 4.5 6.5M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            )
          }
        </div>
      </div>

      <div class="hero-lado">
        {
          site.foto && (
            <figure class="foto">
              <img src={url(site.foto.arquivo)} alt={site.foto.alt} width="960" height="1200" loading="eager" decoding="async" />
            </figure>
          )
        }
        <aside class="areas vidro" aria-labelledby="areas-titulo">
          <p id="areas-titulo" class="areas-titulo">Áreas de atuação</p>
          <ul>
            {
              inicio.areas.map((a) => (
                <li class:list={{ formacao: a.formacao }}>
                  <span class="area-icone" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"><path d={ICONES[iconeArea(a.nome)]} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                  <span>
                    {a.nome}
                    {a.formacao && <span class="em-formacao">em formação</span>}
                  </span>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>

    <div class="container">
      <ul class="indicadores vidro" aria-label="Trajetória em números">
        {
          indicadores.map((i) => (
            <li>
              <span class="ind-icone" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26"><path d={ICONES[i.icone]} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <span class="ind-texto">
                <span class="valor">{i.valor}</span>
                <span class="rotulo">{i.rotulo}</span>
                <span class="detalhe">{i.detalhe}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Sobre + Experiência ============ -->
  <section class="section secao-azul diagonal sobre" aria-labelledby="sobre-titulo">
    <div class="container sobre-grade">
      <div class="revelar">
        <p class="kicker">Sobre mim</p>
        <h2 id="sobre-titulo">Conectando logística, dados e <em class="laranja">tecnologia</em>.</h2>
        <p class="sobre-texto">{inicio.apresentacao}</p>
        <a class="btn btn-ghost" href={url('/sobre/')}>
          Saiba mais sobre mim
          <svg data-seta viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
      <figure class="sobre-imagem revelar">
        <img src={url('/img/fundos/sobre-armazem-1600.webp')} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="container exp-grade">
      <div class="experiencia card revelar" aria-labelledby="exp-titulo">
        <div class="exp-cab">
          <p class="kicker" id="exp-titulo">Experiência profissional</p>
          <p class="exp-empresa">{empresaLogistica.nome} <span>{periodo(empresaLogistica.inicio, empresaLogistica.fim)}</span></p>
        </div>
        <ol class="cargos">
          {
            cargos.map((c, i) => (
              <li class:list={{ atual: i === 0 && !c.fim }}>
                <span class="cargo">{c.titulo}</span>
                <span class="quando">{periodo(c.inicio, c.fim)}</span>
              </li>
            ))
          }
        </ol>
        <a class="link-seta" href={url('/experiencia/')}>Ver experiência completa</a>
      </div>
      <div class="frentes">
        {
          inicio.frentes.map((f, i) => (
            <article class:list={['frente card revelar', { formacao: f.formacao }]}>
              <span class="frente-icone" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22"><path d={ICONES[iconeFrente[i] ?? 'dados']} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <p class="frente-rotulo">{f.titulo}</p>
              <p>{f.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Projetos ============ -->
  <section class="section diagonal projetos-secao" aria-labelledby="projetos-titulo">
    <div class="container">
      <div class="cabecalho-secao">
        <div>
          <p class="kicker">Meus projetos</p>
          <h2 id="projetos-titulo">Soluções para desafios reais de <em class="laranja">logística e dados</em>.</h2>
          <p class="muted">Cada projeto informa se é profissional, acadêmico ou demonstração com dados fictícios.</p>
        </div>
        <a class="btn btn-ghost" href={url('/projetos/')}>Ver todos os {projetos.length} projetos</a>
      </div>
      <ul class="grade-projetos">
        {destaques.map((p) => <li class="revelar"><CartaoProjeto projeto={p} /></li>)}
      </ul>
    </div>
  </section>

  <!-- ============ Demonstrações ============ -->
  <section class="cmd section-cmd" id="demonstracoes" aria-labelledby="demos-titulo">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Demonstrações interativas</p>
        <h2 id="demos-titulo">Experimente, não só leia</h2>
        <p class="muted">Os dois painéis de Power BI que desenvolvi no trabalho, reconstruídos em código, e três demonstrações criadas para o portfólio. Tudo funciona no navegador, com dados fictícios e independentes da Profarma.</p>
      </div>
      <VitrineDemos />
    </div>
  </section>

  <!-- ============ Tecnologias + Trajetória ============ -->
  <section class="section secao-azul" aria-labelledby="ferramentas-titulo">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Tecnologias e habilidades</p>
        <h2 id="ferramentas-titulo">Ferramentas que uso e estudo</h2>
        <p class="muted">"No trabalho" indica uso na rotina profissional; "Em formação", cursos e projetos de estudo. Detalhes de cada competência na página <a href={url('/sobre/#competencias')}>Sobre</a>.</p>
      </div>
      <Tecnologias />

      <div class="trajetoria vidro revelar">
        <p class="trajetoria-cab">
          <span class="trajetoria-titulo">Telemetria de carreira</span>
          <span class="mono muted">atualizado em {mesAno(site.revisadoEm.slice(0, 7))}</span>
        </p>
        <div class="trajetoria-corpo"><RotaCarreira /></div>
      </div>
    </div>
  </section>

  <!-- ============ Formação (seção clara, para respiro) ============ -->
  <section class="section claro formacao" aria-labelledby="formacao-titulo">
    <div class="container formacao-grade">
      <div class="revelar">
        <p class="kicker">Formação e certificados</p>
        <h2 id="formacao-titulo">Conhecimento contínuo para ir ainda mais <em class="laranja">longe</em>.</h2>
        <div class="formacao-links">
          <a class="btn btn-primary" href={url('/formacao/')}>Ver formação</a>
          <a class="btn btn-ghost" href={url('/certificados/')}>Ver certificados</a>
        </div>
      </div>
      <ul class="formacao-cards">
        {
          graduacao && (
            <li class="card revelar">
              <span class="f-icone" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d={ICONES.capelo} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span class="estado andamento">Em andamento</span>
              <span class="f-titulo">{graduacao.curso}</span>
              <span class="f-detalhe">{graduacao.instituicao}, previsão {mesAno(graduacao.data)}</span>
            </li>
          )
        }
        <li class="card revelar">
          <span class="f-icone" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d={ICONES.maleta} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          <span class="estado">Concluídos</span>
          <span class="f-titulo">{formacaoConcluida.map((f) => f.curso).join(' e ')}</span>
          <span class="f-detalhe">{[...new Set(formacaoConcluida.map((f) => f.instituicao))].join(', ')}</span>
        </li>
        <li class="card revelar">
          <span class="f-icone" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d={ICONES.certificado} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          <span class="estado">{cursosConcluidos} concluídos{cursosAndamento.length > 0 && ` · ${cursosAndamento.length} em andamento`}</span>
          <span class="f-titulo">Cursos e certificações</span>
          <span class="f-detalhe">{cursos.filter((c) => c.status === 'concluido').slice(0, 3).map((c) => c.curso).join(' · ')}</span>
        </li>
      </ul>
    </div>
  </section>

  <FaixaContato />
</BaseLayout>

<style>
  .laranja { font-style: normal; color: var(--signal); }
  .claro .laranja { color: var(--accent-ink); }
  .vidro {
    border: 1px solid rgba(160, 190, 228, 0.22);
    border-radius: var(--radius-l);
    background: linear-gradient(180deg, rgba(23, 54, 93, 0.55), rgba(11, 20, 38, 0.72));
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  /* ---------- Abertura ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #060c18;
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .hero-fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }
  .hero-grade {
    display: grid;
    gap: 2.5rem;
    min-height: clamp(560px, 78vh, 760px);
    align-items: center;
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: 2.5rem;
  }
  @media (min-width: 1080px) {
    .hero-grade { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .hero-lado { justify-self: end; display: grid; justify-items: end; gap: 1rem; }
  }
  .selo-topo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0.4rem 0.95rem 0.4rem 0.8rem;
    border: 1px solid var(--cmd-line-2);
    border-radius: var(--radius-pill);
    background: rgba(16, 28, 50, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--cmd-text);
    font-size: 0.9rem;
  }
  .selo-topo i { width: 8px; height: 8px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 0 4px var(--signal-soft), 0 0 12px var(--signal); }
  .nome {
    font-size: clamp(3.1rem, 1.6rem + 6.4vw, 6.25rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.96;
    margin: 0;
  }
  .nome-2 { color: var(--signal); text-shadow: 0 0 40px rgba(255, 121, 31, 0.35); }
  .posicionamento {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 1.1rem 0 1.75rem;
    font: 600 clamp(0.8rem, 0.7rem + 0.4vw, 1rem) / 1.2 var(--font-display);
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--cmd-text);
  }
  .posicionamento::before { content: ''; width: 2.25rem; height: 2px; background: var(--signal); }
  .frase {
    font: 700 clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: #fff;
    max-width: 24ch;
    margin: 0 0 1rem;
  }
  .frase em { font-style: normal; color: var(--signal); }
  .subtitulo { color: var(--cmd-text); opacity: 0.86; max-width: 54ch; margin: 0; font-size: 1.06rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .foto {
    margin: 0;
    width: min(320px, 100%);
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--cmd-line-2);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8);
  }
  .foto img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }

  .areas { padding: 1.15rem 1.2rem 1.2rem; width: min(290px, 100%); }
  .areas-titulo { margin: 0 0 0.75rem; font: 700 1rem/1.2 var(--font-display); color: #fff; }
  .areas ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .areas li { display: flex; align-items: center; gap: 0.75rem; color: var(--cmd-text); font-size: 0.95rem; line-height: 1.3; }
  .area-icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 121, 31, 0.12);
    border: 1px solid rgba(255, 121, 31, 0.35);
    color: var(--signal);
  }
  .areas li.formacao .area-icone { background: transparent; border-style: dashed; }
  .em-formacao { display: inline-block; margin-left: 0.4rem; font-size: 0.72rem; color: var(--signal-text); border: 1px solid rgba(255, 121, 31, 0.5); border-radius: var(--radius-pill); padding: 0 0.45rem; vertical-align: 0.1em; }
  @media (max-width: 1079px) {
    .hero-grade { min-height: 0; }
    .hero-lado { display: grid; gap: 1rem; }
    .areas { width: 100%; }
    .areas ul { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  }

  /* ---------- Indicadores ---------- */
  .indicadores {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 900px) { .indicadores { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .indicadores li { display: flex; align-items: center; gap: 0.9rem; padding: 1.05rem 1.15rem; }
  @media (min-width: 900px) { .indicadores li + li { border-left: 1px solid rgba(255, 121, 31, 0.35); } }
  @media (max-width: 899px) {
    .indicadores li:nth-child(n + 3) { border-top: 1px solid var(--cmd-line); }
    .indicadores li:nth-child(even) { border-left: 1px solid var(--cmd-line); }
    .indicadores li { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  }
  .ind-icone { color: var(--signal); display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 12px; background: rgba(255, 121, 31, 0.1); }
  .ind-texto { display: grid; }
  .valor { font: 800 clamp(1.7rem, 1.4rem + 1.1vw, 2.3rem) / 1 var(--font-display); color: #fff; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .rotulo { font-weight: 600; color: var(--cmd-text); margin-top: 0.2rem; }
