---
import BaseLayout from '../layouts/BaseLayout.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import FaixaContato from '../components/FaixaContato.astro';
import { experiencias } from '../data/trajetoria';
import { site } from '../data/site';
import { duracao, mesAno, periodo } from '../lib/formato';

const referencia = site.revisadoEm.slice(0, 7);
// Empresa atual (ou a mais recente) na abertura: linha do tempo dos cargos
const principal = experiencias.find((e) => e.fim === null) ?? experiencias[0];
---

<BaseLayout
  title="Experiência"
  description="Experiência profissional de Vitor Assis: Profarma (Assistente de Logística II, Assistente de Logística I, Auxiliar de Depósito) e DAGAD."
>
  <CabecalhoPagina
    fundo="experiencia"
    tema="claro"
    kicker="Experiência profissional"
    titulo="Uma jornada de crescimento na logística e tecnologia."
    introducao="Operações logísticas, roteirização e análise de dados no Grupo Profarma, com promoções sucessivas desde 2019."
  >
    <a class="btn btn-primary ver-detalhes" href="#trajetoria">
      Ver detalhes da experiência
      <svg data-seta viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
    <ol slot="lado" class="linha-cargos" aria-label={`Cargos no ${principal.nome}`}>
      {
        principal.cargos.map((c) => (
          <li class:list={['linha-cargo', { atual: c.fim === null }]}>
            <span class="ponto" aria-hidden="true" />
            <div class="linha-cargo-titulo">
              <h2>{c.titulo}</h2>
              <p class="linha-empresa">{principal.nomeCurto}</p>
              <p class="linha-periodo">{periodo(c.inicio, c.fim)}</p>
            </div>
            <p class="linha-resumo">{c.resumo ?? c.atividades[0]}</p>
          </li>
        ))
      }
    </ol>
  </CabecalhoPagina>

  <div class="container empresas" id="trajetoria">
    {
      experiencias.map((e) => (
        <section class="empresa" aria-labelledby={`emp-${e.nomeCurto}`}>
          <header class="emp-cab">
            <h2 id={`emp-${e.nomeCurto}`}>{e.nomeCurto}</h2>
            <p class="muted">{e.nome}</p>
            <p class="periodo">
              {e.fim ? periodo(e.inicio, e.fim) : `desde ${mesAno(e.inicio)}`}
              {e.fim && <span class="muted">, {duracao(e.inicio, e.fim, referencia)}</span>}
            </p>
          </header>
          <ol class="cargos" reversed>
            {e.cargos.map((c, i) => (
              <li class:list={['cargo', { atual: c.fim === null }]}>
                <div class="cargo-corpo">
                <h3>{c.titulo}</h3>
                <p class="periodo-cargo">
                  {periodo(c.inicio, c.fim)}
                  {c.fim === null && <span class="selo-atual">cargo atual</span>}
                </p>
                <ul>
                  {c.atividades.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  <FaixaContato />
</BaseLayout>

<style>
  .empresas { display: grid; gap: var(--section); padding-bottom: var(--section); scroll-margin-top: 6.5rem; }
  .empresa { display: grid; gap: 1.5rem 4rem; }
  @media (min-width: 960px) {
    .empresa { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
    .emp-cab { position: sticky; top: 6.5rem; align-self: start; }
  }
  .emp-cab {
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-l);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid rgba(120, 170, 235, 0.55);
    box-shadow: var(--shadow-1);
  }
  .emp-cab h2 { font-size: var(--step-3); margin-bottom: 0.25rem; }
  .emp-cab p { margin: 0 0 0.35rem; }
  .periodo { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink); }

  .cargos { list-style: none; margin: 0; padding: 0; }
  .cargo {
    position: relative;
    padding: 0 0 1.5rem 2.25rem;
  }
  /* trilho da linha do tempo */
  .cargo::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 1.6rem;
    bottom: 0;
    width: 2px;
    background: var(--line-strong);
  }
  .cargo:last-child::after { display: none; }
  .cargo:last-child { padding-bottom: 0; }
  .cargo::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.45rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--surface);
    border: 3px solid rgba(120, 170, 235, 0.55);
    z-index: 1;
  }
  .cargo.atual::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 5px var(--accent-wash); }
  .cargo > h3,
  .cargo > p,
  .cargo > ul { position: relative; }
  .cargo-corpo {
    padding: 1.2rem 1.4rem 1.35rem;
    border-radius: var(--radius-l);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
  }
  .cargo.atual .cargo-corpo { border-color: rgba(255, 121, 31, 0.45); }
  .cargo h3 { font-size: var(--step-2); margin-bottom: 0.25rem; }
  .periodo-cargo { color: var(--muted); font-variant-numeric: tabular-nums; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin-bottom: 0.9rem; }
  .selo-atual { font-size: 0.8rem; font-weight: 600; color: var(--accent-ink); background: var(--accent-wash); border: 1px solid rgba(255, 121, 31, 0.5); padding: 0 0.55rem; border-radius: 999px; }
  .cargo ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.6rem; max-width: 72ch; }
  .cargo ul li::marker { color: var(--accent); }
</style>
