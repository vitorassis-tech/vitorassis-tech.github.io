---
import BaseLayout from '../layouts/BaseLayout.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import FaixaContato from '../components/FaixaContato.astro';
import { site } from '../data/site';
import { formacaoAcademica, cursos } from '../data/trajetoria';
import { competencias } from '../data/competencias';
import { numero, url } from '../lib/formato';

const horasConcluidas = cursos.filter((c) => c.status === 'concluido').reduce((s, c) => s + (c.cargaHoraria ?? 0), 0);
---

<BaseLayout
  title="Sobre"
  description="Trajetória de Vitor Assis: do armazém ao planejamento de transportes e aos dashboards em Power BI, com estudos em SQL, Python e bancos de dados. Formação, cursos e competências."
>
  <CabecalhoPagina
    imagem="sobre-armazem"
    foco="60% 50%"
    kicker="Sobre mim"
    titulo="Logística na prática, dados como ferramenta"
    introducao={`${site.nomeCompleto}, ${site.local}. Construí minha carreira dentro da operação e uso esse conhecimento para criar análises que fazem sentido para quem decide.`}
  />

  <section class="section container trajetoria" aria-labelledby="trajetoria-titulo">
    <h2 id="trajetoria-titulo" class="visually-hidden">Trajetória</h2>
    <div class="prose texto-longo">
      <p>
        Comecei na indústria, em 2017, abastecendo linhas de produção e fazendo manutenção de extintores. Em 2019 entrei na
        Profarma como auxiliar de depósito, na expedição: separação, conferência das cargas com coletores de dados,
        carregamento e liberação dos veículos, conferência de devoluções e participação em inventários.
      </p>
      <p>
        Em 2025 passei para a área de transportes como Assistente de Logística I: roteirização no Roadnet, documentação de
        transporte, agendamento de entregas e controle de fretes por transportadora. Nessa fase criei meu primeiro
        dashboard em Power BI, de volumetria e ocupação dos veículos do varejo.
      </p>
      <p>
        Em maio de 2026 fui promovido a Assistente de Logística II. Além da roteirização no Roadnet, da gestão de
        transportadoras e fretes e da documentação fiscal de transporte, passei a desenvolver dashboards gerenciais em Power BI, entre eles o{" "}
        <a href={url('/projetos/torre-controle-expedicao/')}>Painel de Expedição</a>, e a evoluir o{" "}
        <a href={url('/projetos/painel-logistica-varejo/')}>Painel de Logística Varejo</a>.
      </p>
      <p>
        Em paralelo, construí base técnica: Power BI (Senac, Xperiun e FAETEC), Administrador de Banco de Dados (Firjan SENAI) e
        Programação em Python (Senac RJ), concluídos, além do Técnico em Logística e do Técnico em Qualidade. Agora estudo
        Inteligência Artificial (FAETEC) e curso a Graduação Tecnológica em Logística (UNISUAM).
      </p>
    </div>
    <aside class="objetivo cmd" aria-labelledby="objetivo-titulo">
      <p class="kicker kicker-escuro">Objetivo</p>
      <h3 id="objetivo-titulo">O que busco</h3>
      <p class="objetivo-texto">{site.objetivo}</p>
      <div class="objetivo-links">
        <a class="btn btn-primary btn-sm" href={url('/projetos/')}>Ver projetos</a>
        <a class="btn btn-linha btn-sm" href={url('/contato/')}>Falar comigo</a>
      </div>
    </aside>
  </section>

  <section class="section container" aria-labelledby="formacao-resumo-titulo">
    <div class="atalhos-formacao">
      <a class="atalho card card-link" id="formacao" href={url('/formacao/')}>
        <span class="kicker">Formação</span>
        <span id="formacao-resumo-titulo" class="atalho-titulo">Graduação, cursos técnicos e ensino médio</span>
        <span class="muted">{formacaoAcademica.map((f) => f.curso).slice(0, 3).join(' · ')}</span>
        <span class="link-seta">Ver formação</span>
      </a>
      <a class="atalho card card-link" id="cursos" href={url('/certificados/')}>
        <span class="kicker">Certificados</span>
        <span class="atalho-titulo">{cursos.filter((c) => c.status === 'concluido').length} cursos concluídos, {numero(horasConcluidas)} horas</span>
        <span class="muted">Power BI, banco de dados, Python, Excel e mais</span>
        <span class="link-seta">Ver certificados</span>
      </a>
    </div>
  </section>

  <section class="section container" id="competencias" aria-labelledby="comp-titulo">
    <div class="section-head">
      <p class="kicker">Competências</p>
      <h2 id="comp-titulo">Competências e evidências</h2>
      <p>Cada competência aponta para onde ela foi usada ou aprendida. Não atribuo níveis sem uma avaliação formal.</p>
    </div>
    <div class="comp-grupos">
      {
        competencias.map((g) => (
          <section class="comp-grupo" aria-labelledby={`g-${g.grupo}`}>
            <h3 id={`g-${g.grupo}`}>{g.grupo}</h3>
            <p class="muted">{g.descricao}</p>
            <dl>
              {g.itens.map((c) => (
                <div class="comp" data-contexto={c.contexto}>
                  <dt>
                    {c.nome}
                    <span class="contexto">{c.contexto === 'trabalho' ? 'Trabalho' : 'Formação'}</span>
                  </dt>
                  <dd>{c.href ? <a href={url(c.href)}>{c.evidencia}</a> : c.evidencia}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>
  </section>

  <FaixaContato />
</BaseLayout>

<style>
  .trajetoria { display: grid; gap: 2.5rem 4rem; padding-top: 0; }
  @media (min-width: 960px) { .trajetoria { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); align-items: start; } }
  .texto-longo { font-size: 1.12rem; line-height: 1.7; }
  .texto-longo p:first-child { font-size: 1.22rem; color: var(--navy); font-weight: 500; }
  .objetivo {
    padding: 1.5rem 1.6rem 1.6rem;
    border-radius: var(--radius-l);
    border-top: 3px solid var(--signal);
    position: sticky;
    top: 6.5rem;
    overflow: hidden;
  }
  .objetivo h3 { font-size: var(--step-2); }
  .objetivo-texto { margin: 0; color: var(--cmd-text); }
  .objetivo-links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; }
  .kicker-escuro { color: #fff; }

  .atalhos-formacao { display: grid; gap: 1rem; }
  @media (min-width: 760px) { .atalhos-formacao { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .atalho { display: grid; gap: 0.45rem; padding: 1.4rem 1.5rem; text-decoration: none; color: var(--ink); scroll-margin-top: 6rem; }
  .atalho .kicker { margin: 0; }
  .atalho-titulo { font: 700 var(--step-2) / 1.25 var(--font-display); color: var(--navy); letter-spacing: -0.02em; }
  .atalho .link-seta { margin-top: 0.4rem; }
  .comp-grupos { display: grid; gap: 3rem 4rem; }
  @media (min-width: 900px) { .comp-grupos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .comp-grupo {
    padding: 1.4rem 1.5rem 0.75rem;
    border-radius: var(--radius-l);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
  }
  .comp-grupo h3 { margin-bottom: 0.25rem; font-size: var(--step-2); }
  dl { margin: 1.25rem 0 0; border-top: 1px solid var(--line); }
  .comp { padding-block: 0.75rem; border-bottom: 1px solid var(--line); }
  .comp:last-child { border-bottom: 0; }
  dt { font-weight: 600; display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .contexto { font-weight: 500; font-size: 0.8rem; color: var(--navy); padding: 0.05rem 0.5rem; border-radius: 999px; border: 1.5px solid var(--navy); white-space: nowrap; }
  .comp[data-contexto='formacao'] .contexto { border-style: dashed; border-color: var(--accent); color: var(--accent-ink); }
  dd { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.95rem; }
</style>
