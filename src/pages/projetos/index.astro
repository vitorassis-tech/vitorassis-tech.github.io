---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CabecalhoPagina from '../../components/CabecalhoPagina.astro';
import ListaProjetos from '../../components/ListaProjetos.astro';
import FaixaContato from '../../components/FaixaContato.astro';
import { projetos, naturezas, type Natureza } from '../../data/projetos';
---

<BaseLayout
  title="Projetos"
  description="Projetos de Vitor Assis em Power BI, SQL, Python, desenvolvimento web e logística, com estudos de caso detalhados e demonstrações interativas."
>
  <CabecalhoPagina
    imagem="hero-globo"
    foco="75% 50%"
    kicker="Projetos"
    titulo="Projetos e estudos de caso"
    introducao="Do painel feito para a gerência às demonstrações abertas com dados fictícios. Cada estudo de caso mostra contexto, decisões, limitações e próximos passos."
  >
    <dl class="legenda-natureza">
      {
        (Object.keys(naturezas) as Natureza[]).map((n) => (
          <div>
            <dt>
              <span class="natureza" data-natureza={n}>{naturezas[n].rotulo}</span>
            </dt>
            <dd>{naturezas[n].explicacao}</dd>
          </div>
        ))
      }
    </dl>
  </CabecalhoPagina>

  <section class="container" aria-label="Lista de projetos">
    <ListaProjetos projetos={projetos} filtros nivelTitulo="h2" />
  </section>

  <div class="espaco"></div>
  <FaixaContato />
</BaseLayout>

<style>
  .legenda-natureza {
    display: grid;
    gap: 1rem 2rem;
    margin: 2.25rem 0 0;
  }
  @media (min-width: 900px) { .legenda-natureza { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .legenda-natureza > div { padding: 1rem 1.1rem; border: 1px solid var(--cmd-line); border-radius: var(--radius-m); background: rgba(255, 255, 255, 0.03); }
  .legenda-natureza dd { margin: 0.6rem 0 0; color: var(--cmd-muted); font-size: 0.93rem; }
  .espaco { height: var(--section); }
</style>
