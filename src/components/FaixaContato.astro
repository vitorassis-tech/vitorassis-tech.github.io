---
import { canaisVisiveis } from '../data/site';
import { url } from '../lib/formato';
interface Props {
  titulo?: string;
  texto?: string;
}
const {
  titulo = 'Vamos conversar sobre dados e tecnologia?',
  texto = 'Estou aberto a oportunidades em análise de dados, Business Intelligence e tecnologia.',
} = Astro.props;
const canais = canaisVisiveis();
const curto = (v: string) => v.replace('linkedin.com/', '').replace('github.com/', '');
---

<section class="faixa-contato cmd" aria-labelledby="faixa-contato-titulo">
  <div class="container">
    <div class="terminal painel-vidro">
      <p class="terminal-barra mono" aria-hidden="true"><i></i><i></i><i></i><span>canais de contato</span></p>
      <div class="terminal-corpo">
        <div>
          <h2 id="faixa-contato-titulo">{titulo}</h2>
          <p class="muted">{texto}</p>
        </div>
        <div>
          <ul class="canais">
            {
              canais.map((c) => (
                <li>
                  <a
                    href={c.href}
                    target={c.id === 'email' ? undefined : '_blank'}
                    rel={c.id === 'email' ? undefined : 'noopener noreferrer'}
                  >
                    <span>{c.rotulo}</span>
                    <span class="mono valor">{curto(c.valor)}</span>
                    {c.id !== 'email' && <span class="visually-hidden"> (abre em nova aba)</span>}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="todos"><a href={url('/contato/')}>Ver página de contato</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .faixa-contato { padding-block: clamp(3rem, 7vw, 5rem); }
  .terminal-barra {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid var(--cmd-line);
    color: var(--cmd-muted);
  }
  .terminal-barra i { width: 10px; height: 10px; border-radius: 50%; background: var(--cmd-line-2); }
  .terminal-barra span { margin-left: 0.5rem; }
  .terminal-corpo { display: grid; gap: 2rem; padding: clamp(1.25rem, 3vw, 2rem); }
  @media (min-width: 900px) {
    .terminal-corpo { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: end; }
  }
  h2 { font-size: var(--step-4); max-width: 16ch; font-weight: 480; letter-spacing: -0.03em; }
  .terminal-corpo p { margin: 0; max-width: 52ch; }
  .canais { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--cmd-line); }
  .canais a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 52px;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--cmd-line);
    text-decoration: none;
    font-weight: 500;
  }
  .canais a:hover .valor { color: var(--signal-text); }
  .valor { color: var(--cmd-muted); overflow-wrap: anywhere; text-align: right; }
  .todos { margin-top: 1rem !important; font-size: 0.95rem; }
</style>
