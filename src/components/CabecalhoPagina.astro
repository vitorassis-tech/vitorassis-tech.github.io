---
/**
 * Abertura das páginas internas: imagem cinematográfica ao fundo (própria, gerada por código),
 * rótulo com traço laranja, título e introdução.
 */
import { url } from '../lib/formato';
import '../styles/fundos.css';
interface Props {
  titulo: string;
  introducao?: string;
  /** Trilha de navegação (ex.: voltar para Todos os projetos) */
  trilha?: { href: string; rotulo: string };
  /** Rótulo da seção, com o traço laranja (ex.: Experiência) */
  kicker?: string;
  /** Nome da imagem em public/img/fundos (sem extensão), ex.: sobre-armazem */
  imagem?: string;
  /** Posição da imagem (object-position) */
  foco?: string;
  /** Tema da abertura: escuro (padrão) ou claro (imagem clara, texto azul-marinho) */
  tema?: 'escuro' | 'claro';
  /** Tema claro: fração da largura ocupada pela imagem à direita (padrão 66%) */
  largura?: string;
  /**
   * Fundo aplicado por CSS (src/styles/fundos.css), com enquadramento próprio por página
   * e por tamanho de tela. Quando informado, substitui `imagem`.
   */
  fundo?: 'experiencia';
  /** Lado do texto sobre o fundo por CSS, para não cobrir o assunto da imagem */
  lado?: 'esquerda' | 'direita';
}
const { titulo, introducao, trilha, kicker, imagem: imagemProp, foco = 'center', tema = 'escuro', largura = '66%', fundo, lado = 'esquerda' } = Astro.props;
const imagem = fundo ? undefined : imagemProp;
const temLado = Astro.slots.has('lado');
---

<header
  class:list={['cabecalho', { 'com-imagem': imagem, 'tema-claro': tema === 'claro', 'com-fundo': fundo, [`fundo-${fundo}`]: fundo, 'texto-direita': fundo && lado === 'direita', 'com-lado': temLado }]}
  style={`--largura-imagem: ${largura}`}
>
  {
    imagem && (
      <img
        class="fundo"
        src={url(`/img/fundos/${imagem}-1600.webp`)}
        srcset={`${url(`/img/fundos/${imagem}-1600.webp`)} 1600w, ${url(`/img/fundos/${imagem}.webp`)} 2560w`}
        sizes="100vw"
        alt=""
        width="2560"
        height="1440"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style={`object-position: ${foco}`}
      />
    )
  }
  <div class="container">
    <div class="bloco-texto">
    {
      trilha && (
        <nav aria-label="Trilha de navegação" class="trilha">
          <a href={trilha.href}>{trilha.rotulo}</a>
        </nav>
      )
    }
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{titulo}</h1>
    {introducao && <p class="lede">{introducao}</p>}
    <slot />
    </div>
    {temLado && <div class="lado"><slot name="lado" /></div>}
  </div>
</header>

<style>
  .cabecalho {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    background:
      radial-gradient(1100px 480px at 80% 10%, rgba(79, 155, 217, 0.15), transparent 60%),
      linear-gradient(160deg, #101c32, #0b1426);
    border-bottom: 1px solid var(--cmd-line);
  }
  .com-imagem { min-height: clamp(360px, 52vh, 520px); display: flex; align-items: center; }
  .com-imagem > .container { width: 100%; }
  .fundo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .com-imagem::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(8, 14, 28, 0.94) 0%, rgba(8, 14, 28, 0.78) 42%, rgba(8, 14, 28, 0.2) 100%);
  }
  /* faixa diagonal laranja */
  .cabecalho::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: -30%;
    bottom: -30%;
    left: 52%;
    width: 160px;
    background: linear-gradient(90deg, transparent, rgba(255, 121, 31, 0.14), transparent);
    border-right: 1px solid rgba(255, 150, 80, 0.4);
    transform: skewX(-24deg);
    pointer-events: none;
  }
  @media (max-width: 759px) {
    .com-imagem::before { background: linear-gradient(180deg, rgba(8, 14, 28, 0.6), rgba(8, 14, 28, 0.92)); }
    .cabecalho::after { left: 70%; }
  }
  h1 { font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4rem); max-width: 20ch; font-weight: 800; letter-spacing: -0.04em; color: #fff; }
  .lede { margin: 0; color: var(--cmd-text); opacity: 0.88; }

  /* ---------- Tema claro (Sobre, Experiência, Formação, Certificados) ---------- */
  .tema-claro {
    --ink: #202b3a;
    --muted: #4a5a70;
    --navy: #17365d;
    background: #eef3f9;
    border-bottom: 1px solid #d9e2ec;
    min-height: clamp(380px, 56vh, 560px);
  }
  .tema-claro.com-imagem::before {
    background: linear-gradient(90deg, rgba(245, 248, 252, 0.97) 0%, rgba(245, 248, 252, 0.9) 34%, rgba(245, 248, 252, 0.35) 55%, rgba(245, 248, 252, 0) 70%);
  }
  .tema-claro::after { display: none; }
  .tema-claro h1 { color: #101c32; }
  .tema-claro h1::after { content: ''; display: block; width: 3.25rem; height: 4px; margin-top: 1.1rem; border-radius: 3px; background: var(--accent); }
  .tema-claro .lede { color: #2c3a4f; opacity: 1; }
  .tema-claro .kicker { color: #17365d; }
  .tema-claro .trilha a { color: #17365d; }
  /* No tema claro a imagem ocupa a direita e se dissolve no fundo claro */
  .tema-claro .fundo {
    left: auto;
    width: var(--largura-imagem, 66%);
    object-position: right center;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 30%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 30%);
  }
  .tema-claro.com-imagem::before { background: linear-gradient(90deg, #f3f6fb 0%, rgba(243, 246, 251, 0.85) 38%, rgba(243, 246, 251, 0) 55%); }
  .tema-claro .lede { max-width: 46ch; }
  .tema-claro { background: linear-gradient(180deg, #f5f8fc, #e9eff7); }
  /* Telas médias: a imagem recua para não ficar sob o título */
  @media (min-width: 760px) and (max-width: 1199px) {
    .tema-claro .fundo { width: min(var(--largura-imagem, 66%), 46%); }
    .tema-claro h1 { font-size: clamp(2.3rem, 1rem + 3.3vw, 3.2rem); }
  }
  @media (max-width: 759px) {
    .tema-claro .fundo { width: 100%; -webkit-mask-image: none; mask-image: none; }
    .tema-claro.com-imagem::before { background: linear-gradient(180deg, rgba(245, 248, 252, 0.75), rgba(245, 248, 252, 0.95)); }
  }
  .trilha { margin-bottom: 1.25rem; font-size: 0.95rem; }
  .trilha a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 32px; }
  .trilha a::before { content: '‹'; font-size: 1.3em; line-height: 1; text-decoration: none; }
</style>
