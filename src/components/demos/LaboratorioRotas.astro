---
/** Laboratório de roteirização — pontos SIMULADOS gerados no navegador. */
---

<div class="lab" data-laboratorio-rotas>
  <div class="aviso-simulado" role="note">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2 1 21h22L12 2zm0 4.5L19.5 19h-15L12 6.5zM11 10v5h2v-5h-2zm0 6v2h2v-2h-2z"/></svg>
    <span>
      <strong>Pontos simulados.</strong> As entregas são posições aleatórias em um plano fictício, sem endereços reais. A
      distância é em linha reta, em unidades do plano.
    </span>
  </div>

  <div class="controles">
    <label>
      <span>Pontos de entrega: <output name="qtd-saida">14</output></span>
      <input type="range" name="qtd" min="5" max="40" step="1" value="14" />
    </label>
    <fieldset>
      <legend>Rota exibida</legend>
      <div class="segmentado">
        <label><input type="radio" name="modo" value="vizinho" /> <span>Vizinho mais próximo</span></label>
        <label><input type="radio" name="modo" value="otimizada" checked /> <span>Após 2-opt</span></label>
      </div>
    </fieldset>
    <button type="button" class="btn btn-ghost gerar">Gerar novos pontos</button>
  </div>

  <div class="palco">
    <div class="mapa" role="img" aria-label="Mapa com o depósito e os pontos de entrega ligados pela rota selecionada. A sequência está descrita na lista ao lado."></div>
    <div class="lateral">
      <dl class="metricas">
        <div><dt>Vizinho mais próximo</dt><dd data-m="vizinho">–</dd></div>
        <div><dt>Após 2-opt</dt><dd data-m="otimizada">–</dd></div>
        <div class="ganho"><dt>Redução calculada</dt><dd data-m="ganho">–</dd></div>
      </dl>
      <p class="resumo-rota" aria-live="polite"></p>
      <details>
        <summary>Sequência de visitas</summary>
        <ol class="sequencia"></ol>
      </details>
    </div>
  </div>
</div>

<script>
  import { iniciarLaboratorio } from '../../scripts/laboratorio-rotas';
  document.querySelectorAll<HTMLElement>('[data-laboratorio-rotas]').forEach((el) => iniciarLaboratorio(el));
</script>

<style>
  .lab {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding: clamp(1rem, 3vw, 1.75rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: 0 1px 0 var(--line), 0 24px 48px -36px rgba(15, 37, 65, 0.35);
  }
  .controles { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: end; }
  .controles > label { display: grid; gap: 0.4rem; font-size: 0.9rem; font-weight: 500; color: var(--muted); min-width: 12rem; flex: 1 1 12rem; }
  output { color: var(--navy); font-weight: 600; font-variant-numeric: tabular-nums; }
  input[type='range'] { width: 100%; accent-color: var(--navy); min-height: 32px; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-size: 0.9rem; font-weight: 500; color: var(--muted); padding: 0; margin-bottom: 0.4rem; }
  .segmentado { display: inline-flex; border: 1.5px solid var(--line-strong); border-radius: var(--radius-m); overflow: hidden; flex-wrap: wrap; }
  .segmentado label { position: relative; cursor: pointer; }
  .segmentado input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .segmentado span { display: inline-flex; align-items: center; min-height: 42px; padding: 0 0.9rem; font-size: 0.92rem; font-weight: 500; color: var(--ink); }
  .segmentado label + label span { border-left: 1.5px solid var(--line-strong); }
  .segmentado input:checked + span { background: var(--navy); color: #fff; }
  .segmentado input:focus-visible + span { box-shadow: inset 0 0 0 3px var(--accent); }

  .palco { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  @media (min-width: 900px) { .palco { grid-template-columns: minmax(0, 3fr) minmax(0, 1.2fr); } }
  .mapa {
    aspect-ratio: 5 / 3;
    border-radius: var(--radius-m);
    background-color: #fbfcfe;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 10% 16.6667%;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .mapa :global(svg) { width: 100%; height: 100%; }
  .metricas { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .metricas > div { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  .metricas dt { font-size: 0.9rem; color: var(--muted); }
  .metricas dd { margin: 0; font-family: var(--font-display); font-size: 1.35rem; color: var(--navy); font-variant-numeric: tabular-nums; }
  .ganho dd { color: var(--accent-ink); }
  .resumo-rota { font-size: 0.9rem; color: var(--muted); margin: 0.75rem 0; }
  summary { cursor: pointer; color: var(--navy); font-weight: 500; min-height: 32px; display: flex; align-items: center; }
  .sequencia { font-size: 0.9rem; padding-left: 1.4rem; max-height: 14rem; overflow: auto; margin: 0.5rem 0 0; }
</style>
