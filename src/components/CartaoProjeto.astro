---
/**
 * Cartão de projeto com imagem de capa. O cartão inteiro é clicável,
 * mas há um único link acessível (o título).
 * Capas de demonstrações e réplicas usam dados fictícios: o cartão avisa.
 */
import SeloNatureza from './SeloNatureza.astro';
import type { Projeto } from '../data/projetos';
import { url } from '../lib/formato';

interface Props {
  projeto: Projeto;
  nivelTitulo?: 'h2' | 'h3';
  /** Carregamento imediato da imagem (só para cartões na primeira dobra) */
  prioridade?: boolean;
  /** Versão completa (página Projetos): problema que resolve, funcionalidades e links reais */
  detalhado?: boolean;
}
const { projeto: p, nivelTitulo = 'h3', prioridade = false, detalhado = false } = Astro.props;
// Funcionalidades = primeiros passos da solução registrada no estudo de caso (sem texto novo)
const funcionalidades = detalhado ? p.solucao.slice(0, 3) : [];
// Links reais externos (ex.: código no GitHub) ficam clicáveis por cima do cartão
const externos = detalhado ? (p.links ?? []).filter((l) => l.externo && /github\.com\/[^/]+\/[^/]+/.test(l.href)) : [];
const Titulo = nivelTitulo;
const capaFicticia = Boolean(p.demo);
---

<article class:list={['cartao card card-link', { detalhado }]}>
  <div class="capa">
    {
      p.imagem ? (
        <img
          src={url(p.imagem.arquivo)}
          alt={p.imagem.alt}
          width="960"
          height="600"
          loading={prioridade ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="capa-vazia" aria-hidden="true" />
      )
    }
    {capaFicticia && <span class="aviso-capa">Dados fictícios</span>}
  </div>
  <div class="corpo">
    <div class="meta">
      <SeloNatureza natureza={p.natureza} detalhe={p.instituicao} />
    </div>
    <Titulo class="titulo">
      <a href={url(`/projetos/${p.slug}/`)}>{p.titulo}</a>
    </Titulo>
    <p class="resumo">{p.resumo}</p>
    {
      detalhado && (
        <div class="bloco">
          <p class="bloco-rotulo">Problema que resolve</p>
          <p class="bloco-texto">{p.problema}</p>
        </div>
      )
    }
    {
      funcionalidades.length > 0 && (
        <div class="bloco">
          <p class="bloco-rotulo">Funcionalidades</p>
          <ul class="func">
            {funcionalidades.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      )
    }
    <ul class="tag-list" aria-label="Tecnologias">
      {p.tecnologias.slice(0, detalhado ? 6 : 4).map((t) => <li>{t}</li>)}
    </ul>
    <div class="rodape-cartao">
      <span class="ver" aria-hidden="true">{detalhado ? 'Explorar projeto' : 'Ver projeto'}</span>
      {
        externos.map((l) => (
          <a class="externo" href={l.href} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 0 0-2.8 17.5c.4.1.6-.2.6-.4v-1.6c-2.5.5-3-1.1-3-1.1-.4-1-1-1.3-1-1.3-.8-.6.1-.6.1-.6.9.1 1.4 1 1.4 1 .8 1.4 2.1 1 2.6.8.1-.6.3-1 .6-1.2-2-.2-4.1-1-4.1-4.4 0-1 .4-1.8.9-2.4-.1-.2-.4-1.1.1-2.4 0 0 .8-.2 2.5.9a8.6 8.6 0 0 1 4.6 0c1.7-1.1 2.5-.9 2.5-.9.5 1.3.2 2.2.1 2.4.6.6.9 1.4.9 2.4 0 3.4-2.1 4.2-4.1 4.4.3.3.6.8.6 1.6v2.4c0 .2.2.5.6.4A9 9 0 0 0 12 3z" /></svg>
            Código
            <span class="visually-hidden">: {l.rotulo} (abre em nova aba)</span>
          </a>
        ))
      }
    </div>
  </div>
</article>

<style>
  .cartao {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }
  .capa {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--cmd-0);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .capa img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s var(--ease);
  }
  .cartao:hover .capa img { transform: scale(1.03); }
  .capa-vazia {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(rgba(160, 190, 228, 0.1) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgba(160, 190, 228, 0.1) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--cmd-0);
  }
  .aviso-capa {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgba(16, 28, 50, 0.88);
    border: 1px solid rgba(255, 121, 31, 0.6);
    color: var(--signal-text);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .corpo {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
    padding: 1.15rem 1.25rem 1.3rem;
  }
  .titulo { font-size: var(--step-1); margin: 0; letter-spacing: -0.015em; }
  .titulo a { color: var(--navy); text-decoration: none; }
  /* Cartão inteiro clicável com um único link */
  .titulo a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .titulo a:focus-visible { box-shadow: none; }
  .cartao:has(.titulo a:focus-visible) { box-shadow: var(--focus); }
  .resumo {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tag-list { margin-top: auto; }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--navy);
  }
  .ver::after { content: '→'; color: var(--accent-ink); transition: transform 0.2s var(--ease); }
  .cartao:hover .ver::after { transform: translateX(3px); }
  .rodape-cartao { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; }
  /* Versão completa: problema e funcionalidades em blocos compactos */
  .detalhado .resumo { -webkit-line-clamp: 2; }
  .bloco { display: grid; gap: 0.3rem; padding: 0.7rem 0.8rem; border-radius: var(--radius-m); background: rgba(255, 255, 255, 0.035); border: 1px solid var(--line); }
  .bloco-rotulo { margin: 0; font: 700 0.72rem/1.2 var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; color: var(--signal-text); }
  .bloco-texto { margin: 0; font-size: 0.9rem; line-height: 1.45; color: var(--cmd-text); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .func { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .func li { position: relative; padding-left: 1.05rem; font-size: 0.88rem; line-height: 1.4; color: var(--cmd-text); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .func li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 6px; height: 6px; border-radius: 2px; background: var(--signal); transform: rotate(45deg); }
  .externo {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 34px;
    padding: 0 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    font: 600 0.85rem/1 var(--font-display);
    text-decoration: none;
  }
  .externo:hover { border-color: var(--signal); background: rgba(255, 121, 31, 0.14); color: #fff; }
</style>
