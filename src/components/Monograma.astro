---
/**
 * Monograma "VA": o V usa a cor do texto (branco no menu escuro, azul em fundo claro)
 * e o A, sem a barra, é o traço laranja de destaque. Puramente decorativo.
 */
interface Props {
  tamanho?: number;
  class?: string;
}
const { tamanho = 36, class: classe } = Astro.props;
---

<svg
  class:list={['monograma', classe]}
  viewBox="0 0 40 28"
  width={tamanho}
  height={Math.round((tamanho * 28) / 40)}
  aria-hidden="true"
  focusable="false"
>
  <path d="M3 4 L12.5 24 L22 4" fill="none" stroke="currentColor" stroke-width="4.6" stroke-linejoin="miter" stroke-linecap="square"></path>
  <path d="M18 24 L27.5 4 L37 24" fill="none" stroke="#FF791F" stroke-width="4.6" stroke-linejoin="miter" stroke-linecap="square"></path>
</svg>

<style>
  .monograma { flex: none; overflow: visible; }
</style>
