---
/**
 * Grade de tecnologias com logotipos coloridos.
 * Ícones de marca: Simple Icons (licença CC0), em src/data/icones-marcas.json.
 * Power BI, DAX, Power Query, Excel, SQL e IA não têm ícone livre: usam pictogramas próprios.
 * Cada item informa onde foi usado: no trabalho ou em formação (nunca "nível avançado").
 */
import icones from '../data/icones-marcas.json';

type Contexto = 'trabalho' | 'formacao';
interface Item {
  nome: string;
  contexto: Contexto;
  /** curso com certificado concluído (estudo, não uso profissional) */
  status?: 'concluido';
  icone?: keyof typeof icones;
  cor?: string;
  proprio?: 'powerbi' | 'dax' | 'powerquery' | 'excel' | 'sql' | 'ia' | 'rota' | 'erp' | 'terminal' | 'xml' | 'cte' | 'rastreio' | 'coletor';
}
const itens: Item[] = [
  { nome: 'Power BI', contexto: 'trabalho', proprio: 'powerbi' },
  { nome: 'DAX', contexto: 'trabalho', proprio: 'dax' },
  { nome: 'Power Query (M)', contexto: 'trabalho', proprio: 'powerquery' },
  { nome: 'Excel avançado', contexto: 'trabalho', proprio: 'excel' },
  { nome: 'JSON', contexto: 'trabalho', icone: 'json', cor: '#e8edf5' },
  { nome: 'CSS', contexto: 'trabalho', icone: 'css', cor: '#4f8fe8' },
  { nome: 'Roadnet', contexto: 'trabalho', proprio: 'rota' },
  { nome: 'SAP', contexto: 'trabalho', proprio: 'erp' },
  { nome: 'Sistema interno (PuTTY)', contexto: 'trabalho', proprio: 'terminal' },
  { nome: 'e-ColdWeb', contexto: 'trabalho', proprio: 'xml' },
  { nome: 'Emite (CT-e)', contexto: 'trabalho', proprio: 'cte' },
  { nome: 'Comprovei', contexto: 'trabalho', proprio: 'rastreio' },
  { nome: 'Coletores de dados', contexto: 'trabalho', proprio: 'coletor' },
  { nome: 'Python', contexto: 'formacao', status: 'concluido', icone: 'python', cor: '#4b8bd0' },
  { nome: 'SQL', contexto: 'formacao', proprio: 'sql' },
  { nome: 'MySQL', contexto: 'formacao', icone: 'mysql', cor: '#5d9bd6' },
  { nome: 'HTML', contexto: 'formacao', icone: 'html', cor: '#f06529' },
  { nome: 'JavaScript', contexto: 'formacao', icone: 'javascript', cor: '#f7df1e' },
  { nome: 'Flask', contexto: 'formacao', icone: 'flask', cor: '#3babc3' },
  { nome: 'Git e GitHub', contexto: 'formacao', icone: 'github', cor: '#ffffff' },
  { nome: 'Inteligência Artificial', contexto: 'formacao', status: 'concluido', proprio: 'ia' },
];
const rotulo = { trabalho: 'No trabalho', formacao: 'Em formação' } as const;
---

<ul class="tecnologias">
  {
    itens.map((t) => (
      <li class="tec card revelar" data-contexto={t.contexto}>
        <span class="logo" aria-hidden="true">
          {t.icone && (
            <svg viewBox="0 0 24 24" width="40" height="40">
              <path d={icones[t.icone].path} fill={t.cor} />
            </svg>
          )}
          {t.proprio === 'powerbi' && (
            <svg viewBox="0 0 24 24" width="40" height="40">
              <rect x="13" y="2" width="6" height="20" rx="1.6" fill="#f2c811" />
              <rect x="8.5" y="7" width="6" height="15" rx="1.6" fill="#e8b10c" />
              <rect x="4" y="12" width="6" height="10" rx="1.6" fill="#c99500" />
            </svg>
          )}
          {t.proprio === 'dax' && (
            <svg viewBox="0 0 24 24" width="40" height="40">
              <rect x="2.5" y="4" width="19" height="16" rx="3" fill="rgba(242,200,17,0.16)" stroke="#f2c811" stroke-width="1.4" />
              <text x="12" y="15.5" text-anchor="middle" font-size="7.5" font-weight="700" font-family="system-ui, sans-serif" fill="#f2c811">fx</text>
            </svg>
          )}
          {t.proprio === 'powerquery' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#5fd08a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 5h16l-6 7v6l-4 2v-8z" fill="rgba(95,208,138,0.16)" />
            </svg>
          )}
          {t.proprio === 'ia' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#ff8a3d" stroke-width="1.6" stroke-linecap="round">
              <path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" />
              <rect x="6" y="6" width="12" height="12" rx="2.5" fill="rgba(255,121,31,0.15)" />
              <circle cx="12" cy="12" r="2.4" fill="#ff8a3d" stroke="none" />
            </svg>
          )}
          {t.proprio === 'excel' && (
            <svg viewBox="0 0 24 24" width="40" height="40">
              <rect x="3" y="3" width="18" height="18" rx="3" fill="#1d8f55" />
              <path d="M3 9h18M3 15h18M9 3v18M15 3v18" stroke="#9fe0bd" stroke-width="1.4" />
            </svg>
          )}
          {t.proprio === 'sql' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#7fb2ff" stroke-width="1.8">
              <ellipse cx="12" cy="5.5" rx="7.5" ry="2.8" fill="rgba(127,178,255,0.2)" />
              <path d="M4.5 5.5v13c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8v-13M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8" />
            </svg>
          )}
          {t.proprio === 'rota' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#ff8a3d" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 18c0-4 12-2 12-7s-6-3-6-6" stroke-dasharray="2.4 2.4" />
              <circle cx="6" cy="18" r="2.4" fill="rgba(255,121,31,0.2)" />
              <path d="M12 2.5c-1.9 0-3.3 1.4-3.3 3.2 0 2.3 3.3 5.3 3.3 5.3s3.3-3 3.3-5.3c0-1.8-1.4-3.2-3.3-3.2z" fill="rgba(255,121,31,0.2)" />
              <circle cx="12" cy="5.7" r="1" fill="#ff8a3d" stroke="none" />
            </svg>
          )}
          {t.proprio === 'erp' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#5aa6ff" stroke-width="1.6" stroke-linejoin="round">
              <rect x="3" y="3" width="7.5" height="7.5" rx="1.6" fill="rgba(90,166,255,0.2)" />
              <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.6" />
              <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.6" />
              <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6" fill="rgba(90,166,255,0.2)" />
            </svg>
          )}
          {t.proprio === 'terminal' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#9fe0bd" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="4" width="19" height="16" rx="2.6" fill="rgba(95,208,138,0.12)" />
              <path d="M6.5 9.5l3 2.5-3 2.5M12 15h5" />
            </svg>
          )}
          {t.proprio === 'xml' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#7fb2ff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2.5h8l4.5 4.5v14.5H6z" fill="rgba(127,178,255,0.15)" />
              <path d="M14 2.5V7h4.5M10 12l-2 2 2 2M14 12l2 2-2 2" />
            </svg>
          )}
          {t.proprio === 'cte' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#ff8a3d" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2.5h8l4.5 4.5v14.5H6z" fill="rgba(255,121,31,0.15)" />
              <path d="M14 2.5V7h4.5M9 14l2.2 2.2L15.5 12" />
            </svg>
          )}
          {t.proprio === 'rastreio' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#5fd08a" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2.5 7.5h10.5v8.5H2.5zM13 10.5h4l3 3v2.5h-7z" fill="rgba(95,208,138,0.15)" />
              <circle cx="6.5" cy="17.5" r="1.8" fill="#0f1b33" />
              <circle cx="16.5" cy="17.5" r="1.8" fill="#0f1b33" />
              <path d="M17.5 3.5a3.5 3.5 0 013 3M17.5 1.2a5.8 5.8 0 015.3 5.3" />
            </svg>
          )}
          {t.proprio === 'coletor' && (
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#f2c811" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="6" y="2.5" width="12" height="19" rx="2.4" fill="rgba(242,200,17,0.12)" />
              <path d="M9 7v5M11 7v5M13 7v5M15 7v5M10 17h4" />
            </svg>
          )}
        </span>
        <span class="nome">{t.nome}</span>
        <span class="contexto">{t.status === 'concluido' ? 'Curso concluído' : rotulo[t.contexto]}</span>
      </li>
    ))
  }
</ul>


<style>
  .tecnologias {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
  }
  @media (min-width: 1000px) { .tecnologias { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .tecnologias { grid-template-columns: repeat(7, minmax(0, 1fr)); } }
  .tec {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 1.3rem 0.75rem 1.1rem;
    text-align: center;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .tec:hover { transform: translateY(-3px); border-color: rgba(255, 121, 31, 0.5); }
  .logo {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line);
    margin-bottom: 0.35rem;
  }
  .nome { font: 700 1rem/1.2 var(--font-display); color: var(--ink); }
  .contexto { font-size: 0.78rem; color: var(--muted); }
  .tec[data-contexto='trabalho'] .contexto { color: var(--accent-ink); font-weight: 600; }
  /* Celular: 3 colunas compactas (mesmos itens e rótulos, menos rolagem) */
  @media (max-width: 639px) {
    .tecnologias { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.55rem; }
    .tec { padding: 0.8rem 0.35rem 0.7rem; gap: 0.2rem; }
    .logo { width: 46px; height: 46px; border-radius: 13px; margin-bottom: 0.2rem; }
    .logo :global(svg) { width: 28px; height: 28px; }
    .nome { font-size: 0.82rem; }
    .contexto { font-size: 0.7rem; }
  }
</style>
