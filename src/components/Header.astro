---
import Monograma from './Monograma.astro';
import { navegacao, site, CURRICULO, temCurriculo } from '../data/site';
import { url } from '../lib/formato';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const atual = Astro.url.pathname.replace(base, '') || '/';
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href.replace(/\/$/, '')));
// Botão de destaque: currículo quando o PDF existir; senão, contato.
const curriculo = temCurriculo();
---

<header class="site-header">
  <div class="container bar">
    <a class="marca" href={url('/')} aria-label={`${site.nome}, página inicial`}>
      <Monograma tamanho={40} />
      <span class="marca-texto">
        <span class="marca-nome">{site.nome}</span>
        <span class="marca-sub">Technology &amp; Data</span>
      </span>
    </a>

    <button class="menu-botao" type="button" aria-expanded="false" aria-controls="menu-principal">
      <span class="menu-linhas" aria-hidden="true"></span>
      <span class="menu-texto">Menu</span>
    </button>

    <nav id="menu-principal" class="nav" aria-label="Principal">
      <ul>
        {
          navegacao.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={ativo(item.href) ? 'page' : undefined}>
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
      {
        curriculo ? (
          <a class="btn btn-primary btn-sm cta" href={url(CURRICULO)} download>
            Baixar currículo
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M8 2v8m0 0 3.5-3.5M8 10 4.5 6.5M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ) : (
          <a class="btn btn-primary btn-sm cta" href={url('/contato/')} aria-current={ativo('/contato/') ? 'page' : undefined}>
            Vamos conversar
            <svg data-seta viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M3 8h10m0 0L9 4m4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const botao = document.querySelector<HTMLButtonElement>('.menu-botao');
  const nav = document.getElementById('menu-principal');
  if (botao && nav) {
    const fechar = () => {
      botao.setAttribute('aria-expanded', 'false');
      nav.classList.remove('aberto');
    };
    botao.addEventListener('click', () => {
      const aberto = botao.getAttribute('aria-expanded') === 'true';
      botao.setAttribute('aria-expanded', String(!aberto));
      nav.classList.toggle('aberto', !aberto);
      if (!aberto) nav.querySelector('a')?.focus();
    });
    // Links para âncoras na mesma página (ex.: Formação) também fecham o menu
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) fechar();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && botao.getAttribute('aria-expanded') === 'true') {
        fechar();
        botao.focus();
      }
    });
    window.matchMedia('(min-width: 1120px)').addEventListener('change', fechar);
  }
</script>

<style>
  /* Barra azul-marinho, comum a todas as páginas */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(16, 28, 50, 0.98);
    color: var(--cmd-text);
    border-bottom: 1px solid var(--cmd-line);
  }
  @supports (backdrop-filter: blur(10px)) {
    .site-header { background: rgba(16, 28, 50, 0.92); backdrop-filter: saturate(1.4) blur(12px); }
  }
  .site-header :focus-visible { box-shadow: var(--focus-escuro); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    text-decoration: none;
  }
  .marca:hover { color: #fff; }
  .marca-texto { display: grid; line-height: 1.1; }
  .marca-nome { font: 700 1.2rem/1.1 var(--font-display); letter-spacing: -0.02em; }
  .marca-sub { font-size: 0.78rem; color: var(--cmd-muted); letter-spacing: 0.02em; }

  .nav { display: flex; align-items: center; gap: 1.25rem; }
  .nav ul {
    display: flex;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    color: var(--cmd-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.97rem;
    border-radius: var(--radius-pill);
    position: relative;
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .nav ul a:hover { background: rgba(255, 255, 255, 0.06); color: #fff; }
  .nav ul a[aria-current='page'] { color: #fff; }
  .nav ul a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 7px;
    height: 2px;
    background: var(--signal);
    border-radius: 2px;
  }
  .cta { white-space: nowrap; }
  .cta[aria-current='page'] { box-shadow: 0 0 0 2px var(--cmd-0), 0 0 0 4px rgba(255, 121, 31, 0.5); }

  .menu-botao {
    display: none;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0 0.95rem;
    border: 1px solid var(--cmd-line-2);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--cmd-text);
    font: 500 1rem var(--font-body);
    cursor: pointer;
  }
  .menu-linhas,
  .menu-linhas::before,
  .menu-linhas::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    position: relative;
    transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .menu-linhas::before,
  .menu-linhas::after { content: ''; position: absolute; left: 0; }
  .menu-linhas::before { top: -6px; }
  .menu-linhas::after { top: 6px; }
  .menu-botao[aria-expanded='true'] .menu-linhas { background: transparent; }
  .menu-botao[aria-expanded='true'] .menu-linhas::before { transform: translateY(6px) rotate(45deg); }
  .menu-botao[aria-expanded='true'] .menu-linhas::after { transform: translateY(-6px) rotate(-45deg); }

  /* 7 itens + botão: abaixo de 1120 px o menu vira painel compacto */
  @media (max-width: 1119px) {
    .menu-botao { display: inline-flex; }
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--cmd-0);
      border-bottom: 1px solid var(--cmd-line-2);
      box-shadow: 0 18px 30px -20px rgba(0, 0, 0, 0.6);
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
    }
    .nav.aberto { display: flex; }
    .nav ul { flex-direction: column; }
    .nav ul a { width: 100%; font-size: 1.1rem; border-radius: var(--radius-m); padding: 0 0.85rem; }
    .nav ul a[aria-current='page']::after { left: 0.85rem; right: auto; width: 1.5rem; }
    .cta { align-self: flex-start; }
  }
  @media (max-width: 420px) {
    .marca-sub { display: none; }
  }
</style>
