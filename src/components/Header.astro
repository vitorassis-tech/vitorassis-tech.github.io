---
import Monograma from './Monograma.astro';
import { navegacao, site, CURRICULO, temCurriculo } from '../data/site';
import { url } from '../lib/formato';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const atual = Astro.url.pathname.replace(base, '') || '/';
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href.replace(/\/$/, '')));
// Botão de destaque: currículo quando o PDF existir; senão, contato.
const curriculo = temCurriculo();
// Na página inicial o menu fica transparente sobre a imagem da abertura até a página rolar.
const transparente = atual === '/';
---

<header class:list={['site-header', { transparente }]}>
  <div class="container bar">
    <a class="marca" href={url('/')} aria-label={`${site.nome}, página inicial`}>
      <Monograma tamanho={52} />
      <span class="marca-texto">
        <span class="marca-nome">{site.nome}</span>
        <span class="marca-sub">Technology &amp; Data</span>
      </span>
    </a>

    <button class="menu-botao" type="button" aria-expanded="false" aria-controls="menu-principal">
      <span class="menu-linhas" aria-hidden="true"></span>
      <span class="menu-texto">Menu</span>
    </button>

    <nav id="menu-principal" class="nav" aria-label="Principal">
      <ul>
        {
          navegacao.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={ativo(item.href) ? 'page' : undefined}>
                {item.href === '/' && (
                  <svg class="casa" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 11 12 3l9 8M5 9.5V21h5v-6h4v6h5V9.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                )}
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="risco" aria-hidden="true"></span>
      {
        curriculo ? (
          <a class="btn btn-escuro btn-sm cta" href={url(CURRICULO)} download>
            Baixar currículo
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M8 2v8m0 0 3.5-3.5M8 10 4.5 6.5M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ) : (
          <a class="btn btn-escuro btn-sm cta" href={url('/contato/')}>
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2M9 15l-3-3 6-7c2.5-2.5 6.5-2.5 9-2-.5 2.5.5 6.5-2 9l-7 6zM14.5 9.5a1.2 1.2 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Vamos conectar?
            <svg data-seta viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M3 8h10m0 0L9 4m4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const botao = document.querySelector<HTMLButtonElement>('.menu-botao');
  const nav = document.getElementById('menu-principal');
  if (botao && nav) {
    const fechar = () => {
      botao.setAttribute('aria-expanded', 'false');
      nav.classList.remove('aberto');
    };
    botao.addEventListener('click', () => {
      const aberto = botao.getAttribute('aria-expanded') === 'true';
      botao.setAttribute('aria-expanded', String(!aberto));
      nav.classList.toggle('aberto', !aberto);
      if (!aberto) nav.querySelector('a')?.focus();
    });
    // Links para âncoras na mesma página (ex.: Formação) também fecham o menu
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) fechar();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && botao.getAttribute('aria-expanded') === 'true') {
        fechar();
        botao.focus();
      }
    });
    window.matchMedia('(min-width: 1280px)').addEventListener('change', fechar);
  }
  // Menu transparente na abertura da página inicial; ganha fundo ao rolar
  const cab = document.querySelector<HTMLElement>('.site-header.transparente');
  if (cab) {
    const atualizar = () => cab.classList.toggle('rolado', window.scrollY > 24);
    atualizar();
    window.addEventListener('scroll', atualizar, { passive: true });
  }
</script>

<style>
  /* Barra azul-marinho, comum a todas as páginas */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(16, 28, 50, 0.98);
    color: var(--cmd-text);
    border-bottom: 1px solid var(--cmd-line);
  }
  @supports (backdrop-filter: blur(10px)) {
    .site-header { background: rgba(16, 28, 50, 0.92); backdrop-filter: saturate(1.4) blur(12px); }
  }
  .site-header { transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease); }
  .site-header.transparente:not(.rolado) { background: linear-gradient(180deg, rgba(6, 12, 24, 0.7), rgba(6, 12, 24, 0)); border-bottom-width: 0; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .site-header :focus-visible { box-shadow: var(--focus-escuro); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 5.25rem;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    text-decoration: none;
  }
  .marca:hover { color: #fff; }
  .marca-texto { display: grid; line-height: 1.1; white-space: nowrap; }
  .marca-nome { font: 700 1.45rem/1.05 var(--font-display); letter-spacing: -0.02em; }
  .marca-sub { font-size: 0.86rem; color: var(--cmd-text); opacity: 0.8; letter-spacing: 0.01em; }

  .nav { display: flex; align-items: center; gap: 1rem; }
  .nav ul {
    display: flex;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.85rem;
    color: #fff;
    text-decoration: none;
    font: 500 1.02rem/1 var(--font-display);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    position: relative;
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .nav ul a:hover { background: rgba(255, 255, 255, 0.06); color: #fff; }
  .casa { color: var(--signal); flex: none; width: 18px; max-width: none; }
  /* Item ativo: pílula com borda laranja e brilho embaixo (como na referência) */
  .nav ul a[aria-current='page'] {
    color: var(--signal-text);
    background: linear-gradient(180deg, rgba(255, 121, 31, 0.16), rgba(255, 121, 31, 0.06));
    border-color: rgba(255, 121, 31, 0.75);
    box-shadow: 0 0 18px -4px rgba(255, 121, 31, 0.55), inset 0 0 12px rgba(255, 121, 31, 0.12);
  }
  .nav ul a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: -9px;
    height: 3px;
    border-radius: 3px;
    background: var(--signal);
    box-shadow: 0 0 12px 2px rgba(255, 121, 31, 0.8);
  }
  .risco {
    width: 46px;
    height: 34px;
    background: linear-gradient(90deg, rgba(255, 121, 31, 0.2), #ff791f 60%, #ffb27a);
    transform: skewX(-32deg);
    border-radius: 3px;
    box-shadow: 0 0 22px rgba(255, 121, 31, 0.55);
  }
  .cta { white-space: nowrap; }

  .menu-botao {
    display: none;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0 0.95rem;
    border: 1px solid var(--cmd-line-2);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--cmd-text);
    font: 500 1rem var(--font-body);
    cursor: pointer;
  }
  .menu-linhas,
  .menu-linhas::before,
  .menu-linhas::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    position: relative;
    transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .menu-linhas::before,
  .menu-linhas::after { content: ''; position: absolute; left: 0; }
  .menu-linhas::before { top: -6px; }
  .menu-linhas::after { top: 6px; }
  .menu-botao[aria-expanded='true'] .menu-linhas { background: transparent; }
  .menu-botao[aria-expanded='true'] .menu-linhas::before { transform: translateY(6px) rotate(45deg); }
  .menu-botao[aria-expanded='true'] .menu-linhas::after { transform: translateY(-6px) rotate(-45deg); }

  /* 7 itens + botão: abaixo de 1120 px o menu vira painel compacto */
  @media (max-width: 1279px) {
    .menu-botao { display: inline-flex; }
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--cmd-0);
      border-bottom: 1px solid var(--cmd-line-2);
      box-shadow: 0 18px 30px -20px rgba(0, 0, 0, 0.6);
      max-height: calc(100dvh - 5.25rem);
      overflow-y: auto;
    }
    .nav.aberto { display: flex; }
    .nav ul { flex-direction: column; }
    .nav ul a { width: 100%; font-size: 1.1rem; border-radius: var(--radius-m); padding: 0 0.85rem; }
    .nav ul a[aria-current='page']::after { display: none; }
    .risco { display: none; }
    .cta { align-self: flex-start; }
  }
  @media (max-width: 420px) {
    .marca-sub { display: none; }
  }
</style>
